{
  "name": "@larkui/core",
  "version": "0.1.1",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/clean-dts.mjs",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "check:components": "node scripts/check-components.mjs"
  },
  "dependencies": {
    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/react": "0.1.0-beta.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@larkui/tokens": "workspace:*",
    "@storybook/react-vite": "^10.6.8",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser": "^5.1.1",
    "@vitest/browser-playwright": "^5.1.1",
    "axe-core": "^4.14.1",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "description": "LarkUI — Feishu Universe Design (UD) components for React 19, built on @ui-sdk/react and Tailwind CSS v4.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ztxtxwd/larkui.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ztxtxwd/larkui#readme",
  "bugs": {
    "url": "https://github.com/ztxtxwd/larkui/issues"
  },
  "license": "MIT",
  "keywords": [
    "lark",
    "feishu",
    "universe-design",
    "ud",
    "design-system",
    "react",
    "ui",
    "tailwindcss",
    "ui-sdk"
  ],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
