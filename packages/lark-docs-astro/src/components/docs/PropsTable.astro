---
/**
 * PropsTable - Renders a props table from the component registry.
 *
 * Usage:
 *   <PropsTable component="Button" />
 *   <PropsTable component="Dialog.Root" />
 */

import {
  getComponentData,
  formatPropType,
  formatDefault,
  type PropSchema,
} from "~/lib/component-registry";
import { PROP_DESCRIPTIONS_ZH } from "~/lib/prop-descriptions";

interface Props {
  /** Component name, e.g., "Button" or "Dialog.Root" for sub-components */
  component: string;
  /** Whether to hide the description column (default: false) */
  hideDescription?: boolean;
  /** Additional prop names to hide from this table. */
  hiddenProps?: string[];
}

const { component, hideDescription = false, hiddenProps = [] } = Astro.props;
const data = getComponentData(component);

// Filter out props that are typically inherited and not useful to document
const HIDDEN_PROPS = new Set(["ref", "key", ...hiddenProps]);

const props = data
  ? Object.entries(data.props).filter(([name]) => !HIDDEN_PROPS.has(name))
  : [];

// Check if any props have descriptions to show the column
const hasDescriptions =
  !hideDescription &&
  props.some(
    ([name, prop]) =>
      PROP_DESCRIPTIONS_ZH[`${component}.${name}`] ||
      prop.description ||
      (prop.type === "enum" && prop.descriptions)
  );
---

{
  data ? (
    <div class="not-prose overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-lark-hairline text-lark-strong">
            <th class="px-4 py-3 text-left font-semibold">属性</th>
            <th class="px-4 py-3 text-left font-semibold">类型</th>
            <th class="px-4 py-3 text-left font-semibold">默认值</th>
            {hasDescriptions && (
              <th class="px-4 py-3 text-left font-semibold">说明</th>
            )}
          </tr>
        </thead>
        <tbody class="text-lark-strong">
          {props.map(([propName, prop]) => {
            const isRequired = prop.required === true || prop.optional === false;
            const typeDisplay = formatPropType(prop);
            const defaultDisplay = formatDefault(prop);

            // Build description: prefer the Chinese overlay, fall back to the
            // registry's English description.
            let description =
              PROP_DESCRIPTIONS_ZH[`${component}.${propName}`] ??
              prop.description ??
              "";

            return (
              <tr class="border-b border-lark-hairline">
                <td class="px-4 py-3 font-mono text-xs">
                  {propName}
                  {isRequired && <span class="text-lark-danger ml-0.5">*</span>}
                </td>
                <td class="px-4 py-3 font-mono text-xs max-w-xs">
                  <code class="text-wrap break-words">{typeDisplay}</code>
                </td>
                <td class="px-4 py-3 font-mono text-xs">
                  {defaultDisplay !== "-" ? <code>{defaultDisplay}</code> : "-"}
                </td>
                {hasDescriptions && (
                  <td class="px-4 py-3 text-xs max-w-md">{description || "-"}</td>
                )}
              </tr>
            );
          })}
        </tbody>
      </table>
      {props.length === 0 && (
        <p class="px-4 py-3 text-sm text-lark-subtle">
          该组件没有专有属性，支持标准 HTML 属性。
        </p>
      )}
    </div>
  ) : (
    <div class="rounded-lg border border-lark-danger/20 bg-lark-danger/5 p-4">
      <p class="text-sm text-lark-danger">
        在注册表中未找到组件 “{component}”。请运行{" "}
        <code>pnpm build:ai-metadata</code> 重新生成。
      </p>
    </div>
  )
}
