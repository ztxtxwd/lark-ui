---
import { ThemeToggle } from "./ThemeToggle";

declare const __LARK_VERSION__: string;

const larkVersion =
  typeof __LARK_VERSION__ !== "undefined" ? __LARK_VERSION__ : "dev";
---

<header
  class="sticky top-0 z-10 h-12 border-b border-lark-hairline bg-lark-canvas hidden lg:flex"
>
  <div
    class="flex min-w-0 flex-1 items-center justify-end border-r border-lark-hairline px-4"
  >
    <a
      href="https://github.com/ztxtxwd/lark-ui"
      target="_blank"
      rel="noopener noreferrer"
      class="font-mono text-sm text-lark-subtle transition-colors hover:text-lark-default"
    >
      @lark-ui/core
      <span class="ml-1 rounded bg-lark-control px-1.5 py-0.5 text-xs">
        v{larkVersion}
      </span>
    </a>
  </div>

  <div class="flex w-12 shrink-0 items-center justify-center">
    <ThemeToggle client:only="react" />
  </div>
</header>
