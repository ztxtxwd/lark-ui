---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  BarChartDemo,
  BasicLineChartDemo,
  LoadingBarChartDemo,
  LoadingChartDemo,
  LoadingToggleChartDemo,
} from "../../components/demos/Chart/ChartDemo";
---

<BaseLayout title="时间序列图表测试">
  <main class="mx-auto mb-64 max-w-3xl space-y-12 p-6 md:p-12">
    <header>
      <h1 class="text-2xl font-semibold text-lark-strong">
        时间序列图表测试
      </h1>
      <p class="mt-2 text-lark-subtle">
        时间序列图表主要状态的测试样例。按 <kbd
          class="rounded bg-lark-tint px-1.5 py-0.5 text-xs">D</kbd
        > 切换深色模式。
      </p>
    </header>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold text-lark-default">基础折线图</h2>
      <div class="rounded-lg border border-lark-hairline bg-lark-base p-4">
        <BasicLineChartDemo client:visible />
      </div>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold text-lark-default">堆叠柱状图</h2>
      <div class="rounded-lg border border-lark-hairline bg-lark-base p-4">
        <BarChartDemo client:visible />
      </div>
    </section>


    <section class="space-y-3">
      <h2 class="text-xl font-semibold text-lark-default">加载中（折线图）</h2>
      <div class="rounded-lg border border-lark-hairline bg-lark-base p-4">
        <LoadingChartDemo client:visible />
      </div>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold text-lark-default">加载中（柱状图）</h2>
      <div class="rounded-lg border border-lark-hairline bg-lark-base p-4">
        <LoadingBarChartDemo client:visible />
      </div>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold text-lark-default">
        加载状态切换
      </h2>
      <div class="rounded-lg border border-lark-hairline bg-lark-base p-4">
        <LoadingToggleChartDemo client:visible />
      </div>
    </section>

  </main>
</BaseLayout>
