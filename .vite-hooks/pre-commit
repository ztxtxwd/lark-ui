if git diff --cached --name-only --diff-filter=ACMR |
  grep -qx 'packages/lark-docs-astro/src/components/skill/design-tips.tsx'; then
  pnpm --filter @lark-ui/docs-astro generate-design-skill
  git add packages/lark-docs-astro/public/skill.md skills/lark-design/SKILL.md
fi
vp staged
